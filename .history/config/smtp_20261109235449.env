# Smart Listener - e-mail settings for alert notifications.
# 1. Copy this file to config/smtp.env (same folder) and fill it in.
# 2. NEVER commit config/smtp.env: it contains a password. It is listed in .gitignore.
# 3. Restart the API (python scripts/run_api.py). Settings > E-mail delivery shows "SMTP CONFIGURED".
# Without config/smtp.env the system runs in TEST MODE: e-mails are saved in data/app/outbox and NOT sent.
#
# Gmail: turn on 2-Step Verification, then create an app password at
#        Google Account > Security > App passwords. Use that 16-character password below, not your normal one.
SL_SMTP_HOST=smtp.gmail.com
SL_SMTP_PORT=587
SL_SMTP_SECURITY=starttls
SL_SMTP_USER=your.address@gmail.com
SL_SMTP_PASSWORD=
SL_SMTP_FROM=your.address@gmail.com
