{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Smart Listener: Flask dashboard",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": ["main.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Smart Listener: Streamlit client",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": ["-m", "streamlit", "run", "app.py", "--server.address", "127.0.0.1", "--server.port", "8502", "--server.headless", "true"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Smart Listener: API and real inference tests",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "test_api.py", "test_inference.py", "test_ui.py", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": []
    }
  ]
}
